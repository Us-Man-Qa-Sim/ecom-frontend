# ── Gateway (server only) ──
# The Next.js server calls the API gateway through NGINX. The browser never does.
#   local dev:  http://localhost:3000   (published NGINX port)
#   compose:    http://nginx:80
API_INTERNAL_URL=http://localhost:3000
# Per-call timeout. Keep it above the gateway's 5 s standard gRPC deadline.
API_TIMEOUT_MS=8000

# ── JWT verification (server only) ──
# The same RSA public key the gateway uses. Next.js only verifies, it never signs.
JWT_PUBLIC_KEY_PATH=../infra/keys/jwt-public.pem
# Must match user-service and the gateway.
JWT_ISSUER=user-service
JWT_AUDIENCE=ecom-api

# ── Cookies (server only) ──
# `true` adds the Secure flag. Use `true` whenever the site is served over HTTPS.
COOKIE_SECURE=false

# ── Images ──
# Comma-separated hostnames `next/image` may load from. Read at BUILD time.
IMAGE_HOSTS=example.com,cdn.example.com,placehold.co

# ── Public (sent to the browser) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# `true` shows the debug footer (last x-request-id and gateway instance).
NEXT_PUBLIC_SHOW_DEBUG=true
